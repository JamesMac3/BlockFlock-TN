{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/features/document-request/pdf/**/*.ts",
    "src/features/document-request/pdf/**/*.tsx",
    "src/features/portal-admin/**/*.ts",
    "src/features/portal-admin/**/*.tsx"
  ]
}
